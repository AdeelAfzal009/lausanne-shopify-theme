{%- style -%}
  #EditorialGallery-{{ section.id }} {
    --events-accent: {{ s.accent_color }};
    --events-text: {{ s.text_color }};
    --events-muted: {{ s.text_color | color_modify: 'alpha', 0.62 }};
    --events-bg: {{ s.background_color }};
    --events-hairline: {{ s.text_color | color_modify: 'alpha', 0.16 }};
    --gallery-ratio: {{ ratio }};
    --gallery-gap: {{ s.tile_gap }}px;
    --gallery-columns: {{ s.columns_desktop }};
    --gallery-columns-tablet: {{ s.columns_tablet }};
    --gallery-columns-mobile: {{ s.columns_mobile }};
  }

  #EditorialGallery-{{ section.id }} .editorial-gallery {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #EditorialGallery-{{ section.id }} .editorial-gallery {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="EditorialGallery-{{ section.id }}"
  class="events-section{% if s.heading_font == 'theme' %} events-section--theme-font{% endif %}"
>
  <div class="editorial-gallery page-width">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="editorial-gallery__header">
        {%- if s.eyebrow != blank -%}
          <p class="events-eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="events-heading editorial-gallery__heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.show_ornament -%}
          <div class="events-ornament" aria-hidden="true"><span></span></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if gallery_shoots.size > 0 -%}
      <editorial-gallery>
        <div class="editorial-gallery__grid">
          {%- for shoot_raw in gallery_shoots -%}
            {%- liquid
              assign shoot_parts = shoot_raw | split: '::'
              assign shoot_name = shoot_parts[0]
              assign shoot_files = shoot_parts[1] | split: ','
              assign cover_url = gallery_cdn_base | append: shoot_files[0] | append: '?width=800'
            -%}

            <button
              type="button"
              class="editorial-gallery__item"
              data-gallery-item
              aria-label="{{ 'View the' | append: ' ' | append: shoot_name | append: ' shoot in full screen' | escape }}"
            >
              <img
                class="editorial-gallery__img"
                src="{{ cover_url }}"
                srcset="{{ gallery_cdn_base | append: shoot_files[0] }}?width=400 400w, {{ gallery_cdn_base | append: shoot_files[0] }}?width=800 800w, {{ gallery_cdn_base | append: shoot_files[0] }}?width=1200 1200w"
                sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
                loading="lazy"
                alt="{{ shoot_name | escape }}"
                width="800"
                height="1067"
              >

              <div class="editorial-gallery__scrim" aria-hidden="true"></div>
              <div class="editorial-gallery__info">
                <h3 class="editorial-gallery__name">{{ shoot_name | escape }}</h3>
              </div>

              <span class="editorial-gallery__zoom" aria-hidden="true">
                <svg viewBox="0 0 20 20" focusable="false">
                  <circle cx="8.5" cy="8.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <path d="M13.4 13.4L18 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  <path d="M8.5 5.8v5.4M5.8 8.5h5.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                </svg>
              </span>
              <script type="application/json" data-gallery-images>
                [
                  {%- for file in shoot_files -%}
                    {%- unless forloop.first -%},{%- endunless -%}
                    {"src": {{ gallery_cdn_base | append: file | append: '?width=2200' | json }}, "alt": {{ shoot_name | json }}}
                  {%- endfor -%}
                ]
              </script>
            </button>
          {%- endfor -%}
        </div>

        {%- comment -%}
          Three steps, not two: shoot tile -> a fast-loading grid of that
          shoot's own thumbnails -> full-screen slider only once a specific
          photo is picked. Jumping straight from the tile to a full-size
          (2200px) image, as this used to, was the slow part; a grid of small
          thumbnails is the same technique already used for the page grid.
        {%- endcomment -%}
        <div class="gallery-lightbox" data-gallery-lightbox hidden>
          <div class="gallery-lightbox__backdrop" data-gallery-lightbox-dismiss></div>

          <div class="gallery-lightbox__grid-wrap" data-gallery-lightbox-grid-wrap hidden>
            <div class="gallery-lightbox__grid-header">
              <h3 class="gallery-lightbox__grid-title" data-gallery-lightbox-grid-title></h3>
              <p class="gallery-lightbox__grid-count" data-gallery-lightbox-grid-count></p>
            </div>
            <div class="gallery-lightbox__grid" data-gallery-lightbox-grid></div>
          </div>

          <div class="gallery-lightbox__stage" data-gallery-lightbox-stage hidden>
            <img class="gallery-lightbox__image" data-gallery-lightbox-image alt="" />
          </div>
          <button
            type="button"
            class="gallery-lightbox__arrow gallery-lightbox__arrow--prev"
            data-gallery-lightbox-prev
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            hidden
          >
            <svg viewBox="0 0 12 20" aria-hidden="true" focusable="false">
              <path d="M10 1L2 10l8 9" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
          <button
            type="button"
            class="gallery-lightbox__arrow gallery-lightbox__arrow--next"
            data-gallery-lightbox-next
            aria-label="{{ 'general.slider.next_slide' | t }}"
            hidden
          >
            <svg viewBox="0 0 12 20" aria-hidden="true" focusable="false">
              <path d="M2 1l8 9-8 9" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
          <p class="gallery-lightbox__counter" data-gallery-lightbox-counter aria-live="polite" hidden></p>
          <button
            type="button"
            class="gallery-lightbox__back"
            data-gallery-lightbox-back
            aria-label="Back to all photos in this shoot"
            hidden
          >
            <svg viewBox="0 0 12 20" aria-hidden="true" focusable="false">
              <path d="M10 1L2 10l8 9" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
          <button
            type="button"
            class="gallery-lightbox__close"
            data-gallery-lightbox-dismiss
            aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" stroke="currentColor" stroke-width="1.4" fill="none">
              <path d="M2 2l12 12M14 2L2 14" />
            </svg>
          </button>
        </div>
      </editorial-gallery>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Editorial gallery",
  "tag": "section",
  "class": "section-editorial-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label above heading",
      "default": "Editorial"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shoots"
    },
    {
      "type": "checkbox",
      "id": "show_ornament",
      "label": "Show diamond divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "Tile shape",
      "options": [
        { "value": "tall", "label": "Tall (2:3)" },
