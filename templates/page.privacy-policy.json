        "collapsible_row_YyTXxR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "3. Use of Your Personal Data",
            "icon": "none",
            "row_content": "<p>Your personal data is processed to:</p><ul><li>Fulfill your orders and manage transactions</li><li>Provide customer support and respond to your requests</li><li>Enhance your online experience and personalize content</li><li>Send updates, invitations, or promotional offers (subject to your consent)</li><li>Comply with our legal and regulatory obligations</li></ul><p>We rely on lawful bases such as contract performance, legitimate interest, and legal compliance when processing your data.</p>",
            "page": ""
          }
        },
        "collapsible_row_ALr8Eh": {
          "type": "collapsible_row",
          "settings": {
            "heading": "4. Data Sharing and Disclosure",
            "icon": "none",
            "row_content": "<p>We may share your personal data with:</p><ul><li><strong>Authorized service providers</strong> for payment processing, logistics, and IT support</li><li><strong>Marketing and analytics partners</strong>, strictly under confidentiality obligations</li><li><strong>Regulatory or legal authorities</strong>, when required by UAE law or court order</li></ul><p>We do <strong>not</strong> sell your data under any circumstances.</p>",
            "page": ""
