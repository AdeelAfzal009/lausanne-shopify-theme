<!-- Contact Sidebar -->
<div id="contactSidebar" class="contact-sidebar">
  <div class="contact-sidebar-header">
    <h2>Any Questions?</h2>
    <button id="closeSidebarBtn" class="close-btn">&times;</button>
  </div>

  <div class="contact-info">
    <p>Our personal advisors are at your disposal to answer any enquiries Monday to Sunday from 10am to 10pm.</p>
    <p>📞  CALL US: +971 42 259 888</p>
    <ul>
      <li>✓ Jewelry experts</li>
      <li>✓ Personalized advice</li>
      <li>✓ Collections discovery</li>
    </ul>
    <div class="sidebar-footer">
      <p>
        <a href="https://lausanne.ae/pages/contact" class="email-link">
          <span>✉️ Email Us</span>
          <span class="sidebar-link-arrow">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        </a>
      </p>
      <p>
        <a href="https://lausanne.ae/pages/request-an-appointment" class="faq-link">
          <span>💬 Book an Appointment</span>
          <span class="sidebar-link-arrow">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        </a>
      </p>
    </div>
  </div>
</div>

<style>
.contact-trigger-btn {
  font-family: Janson MT Std !important;
  padding: 0;
  background-color: transparent;
  color: rgb(var(--color-foreground));
  border: none;
  cursor: pointer;
  font-size: 15px;
  z-index: 1000;
  display: flex;
  align-items: center;
  gap: 8px;
}
.sidebar-footer p {
    margin: 0 !important;
    padding: 0 !important;
    text-align: center;
    text-decoration: none;
}
  .sidebar-footer a {
    text-decoration: none;
}
.contact-trigger-btn .icon {
  font-size: 18px;
}

.contact-trigger-btn {
  width: 100%;
}

.contact-trigger-btn__arrow {
  display: flex;
  margin-left: auto;
  margin-right: 1.5rem;
}

.contact-trigger-btn__arrow svg {
  height: 0.6rem;
  transform: rotate(-90deg);
  transition: transform 0.2s ease;
}

.contact-trigger-btn:hover .contact-trigger-btn__arrow svg {
  transform: rotate(-90deg) translateY(3px);
}

.contact-sidebar {
  position: fixed;
  right: -100%;
  top: 0;
  width: 350px;
  height: 100%;
  background: #fff;
  box-shadow: -2px 0 8px rgba(0,0,0,0.1);
  padding: 20px;
  z-index: 999;
  transition: right 0.3s ease-in-out;
  overflow-y: auto;
}

.contact-sidebar.open {
  right: 0;
}

.contact-sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.close-btn {
  background: none;
  border: none;
  font-size: 26px;
  cursor: pointer;
}

.contact-info p,
.contact-info ul {
  margin-top: 12px;
  font-size: 15px;
}

.contact-info ul {
  padding-left: 20px;
  list-style: none;
  background: #f5f5f5;
  padding: 25px;
}
.contact-info li {
    line-height: 2;
}
.email-link,
.faq-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 8px;
  padding: 12px 0;
  border-bottom: 1px solid #e5e5e5;
  color: #000;
  font-weight: 500;
}

.sidebar-link-arrow {
  display: flex;
  transition: transform 0.2s ease;
}

.sidebar-link-arrow svg {
  width: 14px;
  height: auto;
}

.email-link:hover .sidebar-link-arrow,
.faq-link:hover .sidebar-link-arrow {
  transform: translateX(4px);
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const sidebar = document.getElementById("contactSidebar");
  const openBtn = document.getElementById("contactSidebarBtn");
  const closeBtn = document.getElementById("closeSidebarBtn");

  // Toggle sidebar
  openBtn.addEventListener("click", () => {
    sidebar.classList.add("open");
  });

  closeBtn.addEventListener("click", () => {
    sidebar.classList.remove("open");
  });
});
</script>
