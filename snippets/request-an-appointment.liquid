<style>
  .form-wrapper {
    max-width: 650px;
    margin: auto;
    background: #fff;
    padding: 30px;
  }

  h2 {
    text-align: center;
    margin-bottom: 30px;
  }

  .section {
    border-top: 1px solid #ddd;
    padding: 20px 0;
  }

  .section h3 {
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 10px;
    color: #222;
  }

  .fields {
    display: none;
    margin-top: 10px;
  }

  .section.active .fields {
    display: block;
  }

  select, input, textarea {
    width: 100%;
    padding: 10px 12px;
    margin-bottom: 15px;
    border-radius: 8px;
    border: 1px solid #ccc;
    background: #f9f9f9;
    font-size: 14px;
  }

  input[type="radio"], input[type="checkbox"] {
    width: auto;
    margin-right: 8px;
  }

  .btn {
    background: #111;
    color: #fff;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
  }

  .error-message {
    color: red;
    font-size: 13px;
    margin-top: -10px;
    margin-bottom: 10px;
  }

  .confirmation {
    text-align: center;
    color: green;
    font-weight: bold;
    display: none;
    margin-top: 20px;
  }
  .section-summary {
  display: none;
  padding: 10px 0;
  font-size: 14px;
  color: #444;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.section-summary span {
  font-weight: 500;
}
.form-status {
  padding: 16px;
  border-radius: 8px;
  margin-bottom: 20px;
  text-align: center;
  font-size: 15px;
}
.form-status--success {
  background: #e8f5e9;
  color: #1b5e20;
  border: 1px solid #a5d6a7;
}
.form-status--error {
  background: #fdecea;
  color: #b71c1c;
  border: 1px solid #f5c6cb;
}
.edit-btn {
  background: none;
  color: #000;
  border: none;
  font-size: 14px;
  cursor: pointer;
  text-decoration: none;
}
</style>

<div class="form-wrapper">
  <h2>Request an Appointment</h2>

  {%- form 'contact', id: 'contact_form', class: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
      <div class="form-status form-status--success" role="status" tabindex="-1" autofocus>
        Thank you! Your appointment request has been submitted successfully. Our team will contact you shortly to confirm your booking.
      </div>
    {%- elsif form.errors -%}
      <div class="form-status form-status--error" role="alert" tabindex="-1" autofocus>
        Oops! Please fix the errors and try again.
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <!-- Step 1 -->
    <div class="section" id="section1">
      <h3>1. Select a Shop</h3>
      <div class="section-summary" id="summary1">
        <span id="summaryText1"></span>
        <button type="button" class="edit-btn" onclick="editStep(1)" id="edit1" style="display:none;">Edit</button>
      </div>
      <div class="fields">
        <select name="contact[Shop]" id="shop" required>
          <option value="">Select a Shop</option>
          <option value="Gold Souk">Gold Souk</option>
        </select>
        <div class="error-message" id="error1"></div>
        <button type="button" class="btn" onclick="goToSection(1, 2)">Continue</button>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="section" id="section2">
      <h3>2. Purpose of Your Visit</h3>
      <div class="section-summary" id="summary2">
        <span id="summaryText2"></span>
        <button type="button" class="edit-btn" onclick="editStep(2)" id="edit2" style="display:none;">Edit</button>
      </div>
      <div class="fields">
        <label><input type="radio" name="contact[Visit Type]" value="Discover Lausanne Jewellers creations"> Discover Lausanne Jewellers creations</label><br>
        <label><input type="radio" name="contact[Visit Type]" value="After Sales Services"> After Sales Services</label><br>
        <select name="contact[Purpose]" id="purpose">
          <option value="">Select purpose</option>
          <option value="Bridal">Bridal</option>
          <option value="High_Jewelry">High Jewelry</option>
          <option value="Jewelry">Jewelry</option>
          <option value="Timepieces">Timepieces</option>
        </select>
        <div class="error-message" id="error2"></div>
        <button type="button" class="btn" onclick="goToSection(2, 3)">Continue</button>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="section" id="section3">
      <h3>3. Appointment Details</h3>
      <div class="section-summary" id="summary3">
        <span id="summaryText3"></span>
        <button type="button" class="edit-btn" onclick="editStep(3)" id="edit3" style="display:none;">Edit</button>
      </div>
      <div class="fields">
        <input type="date" name="contact[Appointment Date]" id="appt_date" min="" required>
        <select name="contact[Preferred Time]" id="appt_time">
          <option value="">Select time</option>
          <option>10:00 AM</option>
          <option>11:00 AM</option>
          <option>12:00 PM</option>
          <option>1:00 PM</option>
          <option>2:00 PM</option>
          <option>3:00 PM</option>
          <option>4:00 PM</option>
          <option>5:00 PM</option>
          <option>6:00 PM</option>
          <option>7:00 PM</option>
          <option>8:00 PM</option>
        </select>
        <select name="contact[Preferred Language]" id="language">
          <option value="">Select language</option>
          <option value="English">English</option>
          <option value="Arabic">Arabic</option>
        </select>
        <textarea name="contact[Additional Comments]" placeholder="Comments"></textarea>
        <div class="error-message" id="error3"></div>
        <button type="button" class="btn" onclick="goToSection(3, 4)">Continue</button>
      </div>
    </div>

    <!-- Step 4 -->
    <div class="section" id="section4">
      <h3>4. Personal Information</h3>
      <!-- <div class="section-summary" id="summary4">
        <span id="summaryText4"></span>
        <button type="button" class="edit-btn" onclick="editSection(4)">Edit</button>
      </div> -->
      <div class="fields">
        <label><input type="radio" name="contact[Title]" value="Mr"> Mr</label>
        <label><input type="radio" name="contact[Title]" value="Mrs"> Mrs</label><br>
        <input type="text" name="contact[Name]" placeholder="Full Name" id="fullname">
        <input type="email" name="contact[email]" placeholder="Email Address" id="email">
        <input type="tel" name="contact[Phone]" placeholder="Phone Number" id="phone">
        <input type="text" name="contact[Place of Residence]" placeholder="Place of Residence" id="residence" required>
        <div class="error-message" id="error4"></div>
        <button type="submit" class="btn">Confirm Booking</button>
      </div>
    </div>
  {%- endform -%}
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    setTodayAsMinDate();
    document.getElementById("section1").classList.add("active");
  });

  function setTodayAsMinDate() {
    const today = new Date().toISOString().split("T")[0];
    document.getElementById('appt_date').min = today;
  }

  function goToSection(current, next) {
    let valid = false;

    if (current === 1) {
      const shop = document.getElementById('shop').value;
      valid = shop !== "";
      document.getElementById('error1').innerText = valid ? "" : "Please select a shop.";
      if (valid) {
        document.getElementById('summaryText1').textContent = shop;
        document.getElementById('summary1').style.display = "flex";
        showEditButton(1);
      }
    }

    if (current === 2) {
      const visitTypeEl = document.querySelector('input[name="contact[Visit Type]"]:checked');
      const purpose = document.getElementById('purpose').value;
      valid = visitTypeEl && purpose !== "";
      document.getElementById('error2').innerText = valid ? "" : "Please select a visit type and purpose.";
      if (valid) {
        const visitType = visitTypeEl.value;
        document.getElementById('summaryText2').textContent = `${visitType}, ${purpose}`;
        document.getElementById('summary2').style.display = "flex";
        showEditButton(2);
      }
    }

    if (current === 3) {
      const date = document.getElementById('appt_date').value;
      const time = document.getElementById('appt_time').value;
      const lang = document.getElementById('language').value;
      valid = date && time && lang;
      document.getElementById('error3').innerText = valid ? "" : "Please complete all fields.";
      if (valid) {
        document.getElementById('summaryText3').textContent = `Date: ${date}, Time: ${time}, Language: ${lang}`;
        document.getElementById('summary3').style.display = "flex";
        showEditButton(3);
      }
    }

    if (!valid) return;

    // Hide current section and show next
    document.getElementById(`section${current}`).classList.remove("active");
    document.getElementById(`section${next}`).classList.add("active");

    // Scroll to next
    window.scrollTo({
      top: document.getElementById(`section${next}`).offsetTop - 50,
      behavior: 'smooth'
    });
  }

  function showEditButton(step) {
    document.getElementById(`edit${step}`).style.display = 'inline';
  }

  function editStep(step) {
    // Hide all sections and show selected one
    for (let i = 1; i <= 4; i++) {
      document.getElementById(`section${i}`).classList.remove('active');
    }
    document.getElementById(`section${step}`).classList.add('active');

    // Scroll to section
    window.scrollTo({
      top: document.getElementById(`section${step}`).offsetTop - 50,
      behavior: 'smooth'
    });
  }
</script>


